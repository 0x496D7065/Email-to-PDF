{
  "name": "local-email-to-pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-no-network.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:install:chromium": "playwright install chromium",
    "test:e2e:install:firefox": "playwright install firefox",
    "test:e2e:install:webkit": "playwright install webkit",
    "check:network": "node scripts/check-no-network.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "eslint": "10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "1.28.0",
    "postal-mime": "4.0.8"
  }
}
