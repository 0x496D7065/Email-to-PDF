{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Lets vite.config.ts import "./src/security/headers.ts" with its extension,
    // which Vite's future native config loader requires. Safe: tsc never emits.
    "allowImportingTsExtensions": true
  },
  // scripts/ is included for the check-no-network self-test and its .d.mts
  // types. The .mjs files themselves are not type-checked (no allowJs).
  "include": ["src", "scripts", "vite.config.ts"],
  "exclude": ["dist", "node_modules"]
}
