{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Lets vite.config.ts import "./Source/security-headers/headers.ts" with its extension,
    // which Vite's future native config loader requires. Safe: tsc never emits.
    "allowImportingTsExtensions": true
  },
  // Helper/ (never shipped):
  // - build-checks/ and lint-rules/ for the self-tests and their .d.mts
  //   types. The .mjs files themselves are not type-checked (no allowJs).
  // - Helper/Test/browser-tests/ (and playwright.config.ts): browser tests, type-checked.
  // - Test/test-data/ and Test/test-support/: synthetic fixtures, their .msg
  //   builder, guard tests and shared test helpers.
  // Header/: the shared type definitions (types only, erased at build time),
  // including the .d.ts declarations for `?bytes` imports and node:fs.
  "include": ["Source", "Header", "Helper", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["dist", "node_modules"]
}
