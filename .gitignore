node_modules/
dist/
.vite/
# Playwright output (test runs, reports, browser cache)
test-results/
playwright-report/
blob-report/
playwright/.cache/
# Email files, in ANY letter case: on case-sensitive checkouts (Linux, CI)
# "*.eml" would not match "a.EML", so each letter is a [lower UPPER] pair.
*.[eE][mM][lL]
*.[mM][sS][gG]
*.[mM][bB][oO][xX]
*.[pP][sS][tT]
# Apple Mail messages, Outlook offline mailboxes and Outlook templates: also
# real mail, and never fixtures (no exception below).
*.[eE][mM][lL][xX]
*.[oO][sS][tT]
*.[oO][fF][tT]
# Narrow exception: hand-written SYNTHETIC .eml test emails (see Helper/Test/test-data/README.md).
# No .msg exception: .msg fixtures are built in memory, never stored.
# Real emails stay ignored everywhere else. Must come after the rules above.
!Helper/Test/test-data/**/*.[eE][mM][lL]
# User's local test mail: never commit
/Dummy mail/
# Local junk
.DS_Store
Thumbs.db
*.log

# Local planning files (never committed)
PROJECT_BRIEF.md
STATUS.md
CLAUDE.md
.claude/
