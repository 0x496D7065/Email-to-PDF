# Synthetic email fixtures (tests/fixtures/): keep their exact bytes, with no
# LF/CRLF conversion, so line endings and file hashes are identical on every
# platform (some fixtures use LF, one uses CRLF on purpose).
tests/fixtures/**/*.[eE][mM][lL] -text
# Bundled PDF fonts (Source/pdf-export/fonts/): official IBM Plex files, kept byte for byte
# (the build check compares their SHA-256). "binary" = no line-ending
# conversion and no text diff. The license text next to them is kept
# unchanged too.
Source/pdf-export/fonts/*.woff binary
Source/pdf-export/fonts/LICENSE.txt -text
# Official Ko-fi button image (Source/public/ko-fi/): kept byte for byte. "binary" =
# no line-ending conversion and no text diff.
Source/public/ko-fi/*.png binary
